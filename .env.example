# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="ScopeWise AI"
APP_ENV=local
APP_KEY=
# Never enable debug output in production: it leaks stack traces, file paths,
# environment values and SQL through the JSON error responses.
APP_DEBUG=false
APP_URL=http://localhost:8000

# Origin of the SPA; password-reset links point at {FRONTEND_URL}/reset-password.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# `debug` in production writes request payloads and SQL to disk.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite keeps local setup friction-free. Production must use MySQL or
# PostgreSQL; set DB_CONNECTION=mysql and fill in the credentials below.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=scopewise_ai
# DB_USERNAME=root
# DB_PASSWORD=

# ---------------------------------------------------------------------------
# Session / cache / queue
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# In production behind HTTPS set SESSION_SECURE_COOKIE=true so the session
# cookie never travels over plain HTTP.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# API security
# ---------------------------------------------------------------------------
# Explicit comma separated allow-list. A wildcard is NOT supported because the
# API sends credentials; browsers reject `*` together with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional comma separated regular expressions for multi-tenant deployments.
CORS_ALLOWED_ORIGINS_PATTERNS=

# First-party SPA origins allowed to authenticate with a session cookie
# instead of a bearer token. Keep in sync with CORS_ALLOWED_ORIGINS.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

# Bearer token lifetime in minutes. 1440 = 24 hours. Must never be empty,
# otherwise a leaked token stays valid indefinitely.
SANCTUM_EXPIRATION=1440

# Optional prefix applied to issued tokens so secret scanners can spot them.
SANCTUM_TOKEN_PREFIX=

# ---------------------------------------------------------------------------
# Machine learning service
# ---------------------------------------------------------------------------
# Base URL of the Flask inference service. Must never be exposed publicly.
ML_SERVICE_URL=http://localhost:5000

# Per-request timeout in seconds. Kept well below the queue job timeout so the
# job still has room to retry and fall back.
ML_SERVICE_TIMEOUT=30

# Shared secret sent as X-Service-Token. Must match ML_SERVICE_API_KEY in the
# ML service environment. Generate with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
ML_SERVICE_TOKEN=

# true  : an unreachable ML service falls back to a local heuristic estimate
# false : the failure surfaces so the problem is visible instead of hidden
ML_FALLBACK_ENABLED=true

# ---------------------------------------------------------------------------
# Estimation & pagination
# ---------------------------------------------------------------------------
# Cost figures shown on analyses; the defaults match the frontend's fallback.
ESTIMATION_HOURLY_RATE=67.5
ESTIMATION_PER_DIEM_RATE=540
DEFAULT_TEAM_SIZE=2

# Default page size and the largest ?per_page= a client may request.
PAGINATION_PER_PAGE=20
PAGINATION_MAX_PER_PAGE=100

# ---------------------------------------------------------------------------
# Cloud storage
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Vite
# ---------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"