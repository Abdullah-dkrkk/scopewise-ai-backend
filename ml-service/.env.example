# ML service configuration.
#
# Copy to .env for local development. In production these are real environment
# variables, not a file.

# development | staging | production
ML_ENV=development

# Shared secret the Laravel backend sends as X-Service-Token on every request
# except /health and /ready. Required unless ML_ALLOW_ANONYMOUS=true.
ML_SERVICE_API_KEY=change-me-to-a-long-random-string

# Local development escape hatch. Never enable this on a reachable network.
ML_ALLOW_ANONYMOUS=false

# Retraining rewrites the model files and is expensive. Prefer running
# "python app.py --train" as a one-off job.
ML_ENABLE_TRAINING=false

# Browsers never call this service; leave empty unless you expose it directly.
ML_CORS_ORIGINS=

ML_MIN_TEXT_LENGTH=3
ML_MAX_TEXT_LENGTH=20000
ML_MAX_CONTENT_LENGTH=65536

ML_HOST=0.0.0.0
ML_PORT=5000
ML_DEBUG=false