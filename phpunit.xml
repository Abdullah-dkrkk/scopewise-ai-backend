<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Pin API security config so tests never depend on a developer's
             local .env file. -->
        <env name="CORS_ALLOWED_ORIGINS" value="http://localhost:5173,http://127.0.0.1:5173"/>
        <env name="CORS_ALLOWED_ORIGINS_PATTERNS" value=""/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost,localhost:5173,127.0.0.1,127.0.0.1:5173"/>
        <env name="SANCTUM_EXPIRATION" value="1440"/>
        <!-- Point ML calls at an unroutable address so no test can ever reach a
             real inference service. Tests opt into the heuristic explicitly. -->
        <env name="ML_SERVICE_URL" value="http://127.0.0.1:9"/>
        <env name="ML_SERVICE_TIMEOUT" value="1"/>
        <env name="ML_SERVICE_TOKEN" value=""/>
        <env name="ML_FALLBACK_ENABLED" value="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
